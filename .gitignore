# PlatformIO
.pio/

# VS Code (keep only the recommended extensions)
.vscode/*
!.vscode/extensions.json

# Credentials must never be committed. They are entered at runtime; this
# entry is a safety net in case such a file is ever created locally.
secrets.h
# ...except the secret store of the firmware, which is code, not credentials.
!lib/core/src/core/secrets.h

# Python
__pycache__/

# OS and editor files
.DS_Store
Thumbs.db
*.swp
*~

# Settings page embedded into the firmware (tools/embed_web.py)
src/generated/
